Project(ToolsVersion="14.0", xmlns="http://schemas.microsoft.com/developer/msbuild/2003")
  // Simple single-condition PropertyGroup
  if '$(Configuration)' == '':
    PropertyGroup
      Configuration = Debug
  // Multi-line condition with and/or, wrapped across source lines
  if '$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(HasRuntimeOutput)' == 'true' and '$(RuntimeIdentifier)' == '':
    PropertyGroup
      _UsingDefaultRuntimeIdentifier = true
  // Condition with padded whitespace around the value
  if '$(_InvalidConfigurationError)' == 'true':
    Error(Text="Invalid configuration")
  // Item with Condition plus other attributes
  ItemGroup
    if '$(GenerateUserSecretsAttribute)' == 'true':
      ProjectCapability + "LocalUserSecrets"
  // Target with Condition plus several other attributes
  if '$(_InvalidConfigurationWarning)' != 'true':
    Target Build(
        DependsOnTargets="$(BuildDependsOn)",
        Returns="@(TargetPathWithTargetPlatformMoniker)")
  // Target identity becomes a declaration heading
  Target GetCopyToPublishDirectoryItems(
      DependsOnTargets=[
        PreparePublish
        GetCopyToOutputDirectoryItems
        FinalizePublish
      ],
      Returns="@(AllPublishItemsFullPathWithTargetPath)")
  // Promoted declaration attributes
  UsingTask GenerateManifest(AssemblyFile="$(TasksPath)\BuildTasks.dll")
  Import "build\Common.targets"(Label="Shared build logic")
  if Exists('build\Optional.targets'):
    Import "build\Optional.targets"
  // Labelled property groups and item operations
  PropertyGroup "Compiler settings"
    LangVersion = latest
    Nullable = enable
  ItemGroup
    Compile + "Generated.cs"
    Compile remove "Legacy\**\*.cs"
    Content update "settings.json"
      CopyToOutputDirectory = Always
  // Choose becomes an if/else-if/else chain
  if '$(OS)' == 'Windows_NT':
    PropertyGroup
      PathSeparator = ;
  else if '$(OS)' == 'Unix':
    PropertyGroup
      PathSeparator = :
  else:
    PropertyGroup
      PathSeparator = |
