<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Simple single-condition PropertyGroup -->
  <PropertyGroup Condition="'$(Configuration)' == ''">
    <Configuration>Debug</Configuration>
  </PropertyGroup>

  <!-- Multi-line condition with and/or, wrapped across source lines -->
  <PropertyGroup
      Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' and
                            '$(HasRuntimeOutput)' == 'true' and
                            '$(RuntimeIdentifier)' == ''">
    <_UsingDefaultRuntimeIdentifier>true</_UsingDefaultRuntimeIdentifier>
  </PropertyGroup>

  <!-- Condition with padded whitespace around the value -->
  <Error Condition=" '$(_InvalidConfigurationError)' == 'true' " Text="Invalid configuration" />

  <!-- Item with Condition plus other attributes -->
  <ItemGroup>
    <ProjectCapability
        Condition=" '$(GenerateUserSecretsAttribute)' == 'true' "
        Include="LocalUserSecrets" />
  </ItemGroup>

  <!-- Target with Condition plus several other attributes -->
  <Target
      Condition="'$(_InvalidConfigurationWarning)' != 'true'"
      DependsOnTargets="$(BuildDependsOn)"
      Name="Build"
      Returns="@(TargetPathWithTargetPlatformMoniker)" />

  <!-- Target identity becomes a declaration heading -->
  <Target
      DependsOnTargets="PreparePublish;GetCopyToOutputDirectoryItems;FinalizePublish"
      Name="GetCopyToPublishDirectoryItems"
      Returns="@(AllPublishItemsFullPathWithTargetPath)" />

  <!-- Promoted declaration attributes -->
  <UsingTask
      TaskName="GenerateManifest"
      AssemblyFile="$(TasksPath)\BuildTasks.dll" />
  <Import Project="build\Common.targets" Label="Shared build logic" />
  <Import
      Condition="Exists('build\Optional.targets')"
      Project="build\Optional.targets" />

  <!-- Labelled property groups and item operations -->
  <PropertyGroup Label="Compiler settings">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Generated.cs" />
    <Compile Remove="Legacy\**\*.cs" />
    <Content Update="settings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <_RestoreGraphEntry Include="$([System.Guid]::NewGuid())">
      <TargetFrameworkIdentifier>$(TargetFrameworkIdentifier)</TargetFrameworkIdentifier>
      <TargetFrameworkVersion>$(TargetFrameworkVersion)</TargetFrameworkVersion>
      <TargetFrameworkMoniker>$(TargetFrameworkMoniker)</TargetFrameworkMoniker>
      <TargetFrameworkProfile>$(TargetFrameworkProfile)</TargetFrameworkProfile>
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <TargetPlatformIdentifier>$(TargetPlatformIdentifier)</TargetPlatformIdentifier>
    </_RestoreGraphEntry>
  </ItemGroup>

  <!-- Choose becomes an if/else-if/else chain -->
  <Choose>
    <When Condition="'$(OS)' == 'Windows_NT'">
      <PropertyGroup>
        <PathSeparator>;</PathSeparator>
      </PropertyGroup>
    </When>
    <When Condition="'$(OS)' == 'Unix'">
      <PropertyGroup>
        <PathSeparator>:</PathSeparator>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <PathSeparator>|</PathSeparator>
      </PropertyGroup>
    </Otherwise>
  </Choose>

</Project>
